# ============================================================================
# Util Maker — пример переменных окружения
#
# Скопируйте файл в .env и поправьте значения под свою среду:
#     cp .env.example .env
#
# Makefile не загружает .env автоматически. Переменные сборки можно передать
# через make (make build-windows BUILD_KIND=dev) или экспортировать в shell:
#     set -a; . ./.env; set +a
# Переменные времени выполнения (UTIL_MAKER_LOG_DIR, UTIL_MAKER_MODULES_DIR)
# читает само приложение, поэтому их нужно экспортировать перед запуском.
# ============================================================================

# --- Тип сборки -------------------------------------------------------------
# dev  — подробный журнал, обычная сборка с отладочными записями (по умолчанию).
# release — журнал без DEBUG-записей.
BUILD_KIND=dev

# Тип сборки для компиляции приложения. Makefile передаёт его в cargo-xwin как
# UTIL_MAKER_BUILD; при локальном `cargo build` задайте переменную вручную.
UTIL_MAKER_BUILD=dev

# --- Образы и каталоги Docker (Makefile) -----------------------------------
# Имя образа Linux-контейнера разработки.
DEV_IMAGE=util-maker-dev:local
# Имя образа с Rust, LLVM/LLD, cargo-xwin и NSIS.
WINDOWS_IMAGE=util-maker-windows:local
# Каталог кешей кросс-сборки: реестр Cargo, target и CRT/SDK Microsoft.
WINDOWS_CACHE=.cache/windows-build

# Команда для `make dev-run`. Пустое значение означает, что команду нужно
# передать явно: make dev-run CMD="cargo test --workspace --all-targets".
CMD=

# --- Время выполнения приложения --------------------------------------------
# Каталог журнала. По умолчанию — <папка установки>\logs, затем
# %LOCALAPPDATA%\Util Maker\logs. Пример для Windows: D:\Util Maker\logs.
UTIL_MAKER_LOG_DIR=

# Каталог с установленными модулями. В нём должны лежать подкаталоги модулей,
# например org.utilmaker.control с manifest.json и control-module.exe.
# Нужен для запуска хоста не из каталога установки.
UTIL_MAKER_MODULES_DIR=

# --- Тесты ------------------------------------------------------------------
# Пути к уже собранным процессам для интеграционных тестов. Обычно не задаются:
# тесты сами ищут control-module и fixture-module в target.
UTIL_MAKER_CONTROL_MODULE=
UTIL_MAKER_FIXTURE_MODULE=

# --- Служебные переменные контейнера ---------------------------------------
# Makefile задаёт их сам; переопределяйте только при нестандартной раскладке.
# HOME=/workspace/.cache/util-maker-dev
# CARGO_HOME=/workspace/.cache/util-maker-dev/cargo
# CARGO_TARGET_DIR=/workspace/.cache/windows-build/target
# XWIN_CACHE_DIR=/workspace/.cache/windows-build/xwin

# --- Переменные ОС (задаются системой, не для правки) ----------------------
# %LOCALAPPDATA% — запасной каталог журнала и данных на Windows.
# LOCALAPPDATA=C:\Users\<пользователь>\AppData\Local
# XDG_STATE_HOME — запасной каталог журнала в Linux.
# XDG_STATE_HOME=~/.local/state
