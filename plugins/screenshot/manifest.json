{
  "manifestVersion": 1,
  "id": "org.utilmaker.screenshot",
  "publisher": "org.utilmaker",
  "name": "Скриншоты",
  "version": "0.4.30",
  "hostApi": ">=1.0.0 <2.0.0",
  "entrypoints": {
    "windows-x64": "screenshot-plugin.exe",
    "linux-x64": "screenshot-plugin"
  },
  "icon": "assets/icon.png",
  "capabilities": ["screen.capture", "clipboard.write"],
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "id": "saveDirectory",
        "label": "Папка для сохранения (полный путь; пусто — %USERPROFILE%\\Pictures\\Util Maker)",
        "type": "text",
        "default": ""
      }
    ]
  },
  "actions": [
    {
      "id": "capture-region",
      "name": "Снять область",
      "description": "Выбрать область экрана, при необходимости добавить стрелку или рамку и скопировать результат",
      "recommendedHotkeys": ["Ctrl+Shift+S"]
    }
  ]
}
