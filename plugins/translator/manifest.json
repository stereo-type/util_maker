{
  "manifestVersion": 1,
  "id": "org.utilmaker.translator",
  "publisher": "org.utilmaker",
  "name": "Переводчик",
  "version": "0.4.22",
  "hostApi": ">=1.0.0 <2.0.0",
  "entrypoints": {
    "windows-x64": "translator-module.exe",
    "linux-x64": "translator-module"
  },
  "capabilities": [
    "selection.read",
    "settings.read",
    "secret.read",
    "clipboard.write"
  ],
  "actions": [
    {
      "id": "translate",
      "name": "Перевести текст",
      "description": "Перевести текущее выделение или явно введённый текст",
      "recommendedHotkeys": [
        "Ctrl+Shift+T"
      ]
    }
  ],
  "settings": {
    "schemaVersion": 1,
    "profileField": "activeProfile",
    "fields": [
      {
        "id": "activeProfile",
        "label": "Активный профиль",
        "type": "select",
        "default": "yandex",
        "options": [
          {
            "value": "yandex",
            "label": "Яндекс"
          },
          {
            "value": "google",
            "label": "Google"
          }
        ]
      }
    ],
    "profiles": [
      {
        "id": "yandex",
        "name": "Яндекс",
        "fields": [
          {
            "id": "sourceLang",
            "label": "Исходный язык",
            "type": "select",
            "default": "auto",
            "options": [
              {
                "value": "auto",
                "label": "Авто"
              },
              {
                "value": "en",
                "label": "Английский"
              },
              {
                "value": "ru",
                "label": "Русский"
              },
              {
                "value": "de",
                "label": "Немецкий"
              }
            ]
          },
          {
            "id": "targetLang",
            "label": "Целевой язык",
            "type": "select",
            "default": "ru",
            "options": [
              {
                "value": "en",
                "label": "Английский"
              },
              {
                "value": "ru",
                "label": "Русский"
              },
              {
                "value": "de",
                "label": "Немецкий"
              }
            ]
          },
          {
            "id": "apiKey",
            "label": "API-ключ",
            "type": "secret",
            "required": true,
            "secretRef": "translator/yandex/apiKey"
          }
        ]
      },
      {
        "id": "google",
        "name": "Google",
        "fields": [
          {
            "id": "sourceLang",
            "label": "Исходный язык",
            "type": "select",
            "default": "auto",
            "options": [
              {
                "value": "auto",
                "label": "Авто"
              },
              {
                "value": "en",
                "label": "Английский"
              },
              {
                "value": "ru",
                "label": "Русский"
              },
              {
                "value": "de",
                "label": "Немецкий"
              }
            ]
          },
          {
            "id": "targetLang",
            "label": "Целевой язык",
            "type": "select",
            "default": "ru",
            "options": [
              {
                "value": "en",
                "label": "Английский"
              },
              {
                "value": "ru",
                "label": "Русский"
              },
              {
                "value": "de",
                "label": "Немецкий"
              }
            ]
          },
          {
            "id": "apiKey",
            "label": "API-ключ",
            "type": "secret",
            "required": true,
            "secretRef": "translator/google/apiKey"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "testConnection",
        "name": "Проверить подключение",
        "profileField": "activeProfile",
        "fields": [
          "sourceLang",
          "targetLang"
        ]
      }
    ]
  }
}
