{
  "manifestVersion": 1,
  "id": "org.utilmaker.translator",
  "publisher": "org.utilmaker",
  "name": "Переводчик",
  "version": "0.4.39",
  "hostApi": ">=1.1.0 <2.0.0",
  "entrypoints": {
    "windows-x64": "translator-module.exe",
    "linux-x64": "translator-module"
  },
  "icon": "assets/icon.png",
  "capabilities": [
    "selection.read",
    "settings.read",
    "clipboard.write",
    "extensions.read",
    "extensions.call"
  ],
  "actions": [
    {
      "id": "translate",
      "name": "Перевести текст",
      "description": "Перевести текущее выделение или явно введённый текст",
      "recommendedHotkeys": [
        "Ctrl+Shift+T"
      ]
    }
  ],
  "extensionPoints": [
    {
      "id": "translation-provider",
      "name": "Провайдер перевода",
      "contract": "util-maker.translation.provider",
      "contractVersion": "1.0.0",
      "selection": "single",
      "required": true
    }
  ],
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "id": "sourceLang",
        "label": "Исходный язык",
        "type": "select",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Авто"
          },
          {
            "value": "en",
            "label": "Английский"
          },
          {
            "value": "ru",
            "label": "Русский"
          },
          {
            "value": "de",
            "label": "Немецкий"
          }
        ]
      },
      {
        "id": "targetLang",
        "label": "Целевой язык",
        "type": "select",
        "default": "ru",
        "options": [
          {
            "value": "en",
            "label": "Английский"
          },
          {
            "value": "ru",
            "label": "Русский"
          },
          {
            "value": "de",
            "label": "Немецкий"
          }
        ]
      }
    ]
  }
}
